# ==============================================================================
# EVE Trade - Environment Configuration
# ==============================================================================
# All configuration is loaded dynamically via process.env.
# Never commit real secrets to version control.

# EVE Online SSO Application Credentials (developers.eveonline.com)
# Required for character wallet, personal orders, and skill sync.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Explicit EVE SSO Callback URL (Recommended for production/reverse-proxies)
# Example: https://my-eve-trade-domain.com/auth/callback
# If left empty, the server automatically derives it from request headers (Host + Protocol).
EVE_CALLBACK_URL=

# Application Environment ('development' | 'production')
NODE_ENV=development
