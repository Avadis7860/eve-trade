  "legacy": {
    "fleet_model": {
      "status": "removed",
      "replacement": "character_and_corporation_scope",
      "rule": "Do not reintroduce fleet_consolidated, fleet financial engines, fleet execution-plan UI, or fleet order scope."
    },
    "character_financial_boundary": {
      "status": "deprecated",
      "replacement": "explicit_accounting_scope_id_and_economic_ecosystem",
      "rule": "character identity is not automatically an accounting boundary."
    },
    "character_order_alias": {
      "status": "compatibility",
      "symbol": "EveCharacterOrder",
      "replacement": "MarketOrder",
      "rule": "Do not create a separate character-owned order entity."
    },
    "old_financial_projection": {
      "status": "compatibility",
      "replacement": "PositionLedger_to_RealizedFinancialOutcome",
      "rule": "Do not rebuild a second accounting ledger in analytics or UI."
    }
  },
  "hotspots": {
    "orchestration": [
      "src/App.tsx"
    ],
    "persistence": [
      "src/services/indexedDbStore.ts"
    ],
    "analytics": [
      "src/services/traderAnalytics.ts"
    ],
    "large_ui": [
      "src/components/ConfigurationPanel.tsx",
      "src/components/MyOrdersView.tsx",
      "src/components/OpportunityModal.tsx"
    ],
    "rule": "Hotspots are explicit maintenance targets, not opportunistic refactoring targets."
  },
  "validation": {
    "context": "npm run test:context",
    "context_manifest": ".eve-trade/current-work.json",
    "workflow_contract": "npm run test:ci-config",
    "minimal_local": [
      "npm run test:context",
      "npm run typecheck",
      "npm run typecheck:server",
      "npm test",
      "npm run build"
    ]
  }
}
